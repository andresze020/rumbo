{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "disableSkillShellExecution": true,
  "maxSkillDescriptionChars": 700,
  "skillListingBudgetFraction": 0.005,
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run dev)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run build)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run dev)"
    ],
    "ask": [
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch -c *)",
      "Bash(npx supabase *)",
      "PowerShell(npx supabase *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*service-role*)",
      "Read(**/*service_role*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git tag *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase db reset*)",
      "Bash(npx supabase db remote*)",
      "PowerShell(npx supabase db push*)",
      "PowerShell(npx supabase db reset*)",
      "PowerShell(npx supabase db remote*)",
      "Bash(rm -rf *)",
      "Bash(rmdir /s *)",
      "PowerShell(Remove-Item * -Recurse *)"
    ]
  }
}
