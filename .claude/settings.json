{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "disableSkillShellExecution": true,
  "maxSkillDescriptionChars": 700,
  "skillListingBudgetFraction": 0.005,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-context.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-gate.mjs",
            "timeout": 360
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run i18n:check)",
      "Bash(npx tsc --noEmit)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run build)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run i18n:check)",
      "PowerShell(npx tsc --noEmit)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(gh pr merge *)",
      "Bash(git pull)"
    ],
    "ask": [
      "Bash(npx supabase *)",
      "PowerShell(npx supabase *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*service-role*)",
      "Read(**/*service_role*)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase db reset*)",
      "Bash(npx supabase db remote*)",
      "PowerShell(npx supabase db push*)",
      "PowerShell(npx supabase db reset*)",
      "PowerShell(npx supabase db remote*)",
      "Bash(rm -rf *)",
      "Bash(rmdir /s *)",
      "PowerShell(Remove-Item * -Recurse *)"
    ]
  }
}
