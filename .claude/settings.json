{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "disableSkillShellExecution": true,
  "maxSkillDescriptionChars": 700,
  "skillListingBudgetFraction": 0.005,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-context.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-gate.mjs",
            "timeout": 360
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run i18n:check)",
      "Bash(npx tsc --noEmit)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run build)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run i18n:check)",
      "PowerShell(npx tsc --noEmit)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(gh pr merge *)",
      "Bash(git pull)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(node --check *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(git remote -v)",
      "Bash(git fetch *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "PowerShell(npm run *)"
    ],
    "ask": [
      "Bash(npx supabase *)",
      "PowerShell(npx supabase *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*service-role*)",
      "Read(**/*service_role*)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase db reset*)",
      "Bash(npx supabase db remote*)",
      "PowerShell(npx supabase db push*)",
      "PowerShell(npx supabase db reset*)",
      "PowerShell(npx supabase db remote*)",
      "Bash(rm -rf *)",
      "Bash(rmdir /s *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(package-lock.json)",
      "Read(**/package-lock.json)",
      "Read(tsconfig.tsbuildinfo)",
      "Read(**/*.tsbuildinfo)",
      "Read(**/coverage/**)",
      "Read(**/*.log)"
    ]
  },
  "disabledMcpjsonServers": [
    "supabase"
  ]
}
